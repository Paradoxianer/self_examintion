gitignore
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Generelles Build-Verzeichnis
/build/

# Flutter Generated Files (Platform specific)
# These files are generated by Flutter and should not be versioned.

# Android
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
android/app/src/main/kotlin/io/flutter/plugins/GeneratedPluginRegistrant.kt
# android/app/build/ # Bereits abgedeckt durch /build/ oder spezifischer, falls nötig
# android/.gradle/ # Abgedeckt durch generelle Build-Ordner Regeln, aber explizit ist auch ok
# android/local.properties # Sollte immer ignoriert werden, da es lokale Pfade enthält

# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/FlutterPluginRegistrant/Classes/GeneratedPluginRegistrant.[hm]
ios/Runner/GeneratedPluginRegistrant.[hm]
# ios/Pods/ # CocoaPods, oft ignoriert
# ios/Flutter/App.framework # und andere Frameworks im Flutter-Ordner (oft Teil von .flutter-plugins-dependencies)
ios/Flutter/ephemeral/ # Wichtig für Desktop und einige Build-Prozesse

# Linux
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugins.cmake
linux/flutter/CMakeLists.txt # Internes CMakeFile von Flutter für Linux
linux/ephemeral/

# macOS
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Flutter/Generated/
# macos/Pods/ # CocoaPods, oft ignoriert
macos/Flutter/ephemeral/

# Windows
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugins.cmake
windows/flutter/CMakeLists.txt # Internes CMakeFile von Flutter für Windows
windows/runner/Debug/
windows/runner/Profile/
windows/runner/Release/
windows/ephemeral/

# Flutter assemble files
flutter_assemble.d

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
# Die folgenden sind spezifischer als ein generisches /build/ und gut so
/android/app/debug
/android/app/profile
/android/app/release

